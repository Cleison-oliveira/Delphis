# Auto detect text files and perform LF normalization
*           text=auto eol=lf

# Source files
*.cs        text diff=csharp eol=lf
*.cshtml    text diff=html eol=lf
*.csx       text diff=csharp eol=lf

# Project and solution files
*.sln       text eol=lf
*.csproj    text eol=lf
*.props     text eol=lf
*.targets   text eol=lf
*.nix       text eol=lf
*.py        text eol=lf
*.md        text eol=lf
*.json      text eol=lf

